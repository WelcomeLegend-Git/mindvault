<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowlist non-credential data for both backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="FocusModePrefs.xml" />
        <include domain="sharedpref" path="mindvault_stats.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FocusModePrefs.xml" />
        <include domain="sharedpref" path="mindvault_stats.xml" />
    </device-transfer>
</data-extraction-rules>
