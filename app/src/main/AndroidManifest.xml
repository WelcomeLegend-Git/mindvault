<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for focus mode functionality -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Special access granted by the user in Settings; needed to read app-usage events. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".MindVaultApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/mindvault_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/mindvault_logo"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:resizeableActivity="false"
        android:theme="@style/Theme.MindVault">
        
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MindVault"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MindVault"
            android:launchMode="singleTask"
            android:excludeFromRecents="false" />
        
        <activity
            android:name=".ui.FocusModeSetupActivity"
            android:exported="false"
            android:label="Focus Mode Setup"
            android:theme="@style/Theme.MindVault" />
            
        <activity
            android:name=".ui.StatisticsActivity"
            android:exported="false"
            android:label="Statistics"
            android:theme="@style/Theme.MindVault" />
            
        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false"
            android:label="Profile"
            android:theme="@style/Theme.MindVault" />
            
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:label="Login"
            android:theme="@style/Theme.MindVault" />
            
        <activity
            android:name=".ui.AchievementsActivity"
            android:exported="false"
            android:label="Achievements"
            android:theme="@style/Theme.MindVault" />
            
        <activity
            android:name=".ui.HelpCenterActivity"
            android:exported="false"
            android:label="Help Center"
            android:theme="@style/Theme.MindVault" />
        
        <activity
             android:name=".ui.AboutActivity"
             android:exported="false"
             android:label="About"
             android:theme="@style/Theme.MindVault" />
        
        <activity
            android:name=".ui.EditProfileActivity"
            android:exported="false"
            android:label="Edit Profile"
            android:theme="@style/Theme.MindVault" />
        
        <activity
            android:name=".ui.SecurityActivity"
            android:exported="false"
            android:label="Security"
            android:theme="@style/Theme.MindVault" />

        <activity
            android:name=".ui.AdvancedProtectionActivity"
            android:exported="false"
            android:label="Advanced Protection"
            android:theme="@style/Theme.MindVault"
            android:resizeableActivity="false" />

        <activity
            android:name=".ui.LockScreenActivity"
            android:exported="false"
            android:label="Lock Screen"
            android:theme="@style/Theme.MindVault" />

        <activity
            android:name=".ui.NotificationSettingsActivity"
            android:exported="false"
            android:label="Notifications"
            android:theme="@style/Theme.MindVault" />
            
        <activity
            android:name=".AppBlockedActivity"
            android:exported="false"
            android:label="App Blocked"
            android:theme="@style/Theme.MindVault"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <activity
            android:name=".ui.PermissionActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MindVault" />

        <activity
            android:name=".ui.AppCompatibilityActivity"
            android:exported="false"
            android:label="App Compatibility"
            android:theme="@style/Theme.MindVault" />
            

            
        <service
            android:name=".services.FocusAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:label="MindVault Focus Service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".services.FocusNotificationListenerService"
            android:label="MindVault Notification Service"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
            
        <activity
            android:name=".ui.DeveloperSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.MindVault" />
        
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.MindVaultDeviceAdminReceiver"
            android:exported="false"
            android:label="MindVault Uninstall Protection"
            android:description="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.FocusReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.mindvault.FOCUS_REMINDER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>